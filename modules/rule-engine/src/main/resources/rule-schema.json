{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:eventconductor:rule-schema",
  "title": "EventConductor Rule",
  "description": "A business rule: either an expression rule (when/then) or a decision table (inputs/outputs/rows).",
  "type": "object",
  "required": ["name", "type"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": ["string", "null"],
      "description": "Unique identifier. Auto-generated on save if omitted.",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "description": "Human-readable name of the rule.",
      "minLength": 1
    },
    "description": {
      "type": ["string", "null"],
      "description": "Optional free-text description."
    },
    "type": {
      "enum": ["expression", "decision-table"],
      "description": "Kind of rule."
    },
    "version": {
      "type": "integer",
      "description": "Definition version number.",
      "minimum": 0
    },
    "salience": {
      "type": "integer",
      "description": "Priority when evaluating by tag: higher salience runs first."
    },
    "tags": {
      "type": ["array", "null"],
      "items": { "type": "string" },
      "description": "Tags for group evaluation."
    },
    "when": {
      "type": ["string", "null"],
      "description": "JEXL condition of an expression rule. Omit for an unconditional rule."
    },
    "then": {
      "type": ["array", "null"],
      "items": { "$ref": "#/definitions/assignment" },
      "description": "Output assignments of an expression rule."
    },
    "inputs": {
      "type": ["array", "null"],
      "items": { "type": "string", "minLength": 1 },
      "description": "Input fact paths (columns) of a decision table."
    },
    "outputs": {
      "type": ["array", "null"],
      "items": { "type": "string", "minLength": 1 },
      "description": "Output names (columns) of a decision table."
    },
    "rows": {
      "type": ["array", "null"],
      "items": { "$ref": "#/definitions/row" },
      "description": "Rows of a decision table."
    },
    "hitPolicy": {
      "enum": ["FIRST", "COLLECT", null],
      "description": "FIRST (default) stops at the first matching row; COLLECT gathers all matching rows."
    }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "expression" } } },
      "then": { "required": ["then"], "properties": { "then": { "type": "array", "minItems": 1 } } }
    },
    {
      "if": { "properties": { "type": { "const": "decision-table" } } },
      "then": {
        "required": ["inputs", "outputs", "rows"],
        "properties": {
          "inputs": { "type": "array", "minItems": 1 },
          "outputs": { "type": "array", "minItems": 1 },
          "rows": { "type": "array", "minItems": 1 }
        }
      }
    }
  ],
  "definitions": {
    "assignment": {
      "type": "object",
      "required": ["name", "expression"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "expression": { "type": "string", "minLength": 1 }
      }
    },
    "row": {
      "type": "object",
      "required": ["when", "then"],
      "additionalProperties": false,
      "properties": {
        "when": { "type": "array", "items": { "type": "string" } },
        "then": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
