{
  "id": "order-saga",
  "name": "Order saga (reserve → charge → confirm, with compensation)",
  "version": 1,
  "steps": [
    { "id": "start", "type": "START", "name": "Start" },

    { "id": "reserve", "type": "ACTION", "name": "Reserve stock", "topic": "bench",
      "preconditionStepId": "start", "rollbackable": true, "compensationStepId": "cancel-reserve" },

    { "id": "risky-charge", "type": "ACTION", "name": "Charge card", "topic": "bench",
      "preconditionStepId": "reserve", "retries": 2,
      "rollbackable": true, "compensationStepId": "refund" },

    { "id": "confirm", "type": "ACTION", "name": "Confirm order", "topic": "bench",
      "preconditionStepId": "risky-charge" },

    { "id": "end", "type": "END", "name": "End", "preconditionStepId": "confirm" },

    { "id": "refund", "type": "ACTION", "name": "Refund charge", "topic": "bench" },
    { "id": "cancel-reserve", "type": "ACTION", "name": "Cancel reservation", "topic": "bench" }
  ]
}
