{
  "id": "link-guard-discard",
  "name": "A link condition that discards rather than waits",
  "version": 1,
  "steps": [
    {
      "id": "start",
      "type": "START",
      "name": "Start"
    },
    {
      "id": "validate",
      "type": "ACTION",
      "name": "Validate the cancellation",
      "topic": "work",
      "preconditionStepId": "start"
    },
    {
      "id": "penalty",
      "type": "ACTION",
      "name": "Charge the penalty, when there is one",
      "topic": "work",
      "preconditions": [
        {
          "stepId": "validate",
          "expression": "ratePlan == 'NON_REFUNDABLE'",
          "onFalse": "DISCARD"
        }
      ]
    },
    {
      "id": "end",
      "type": "END",
      "name": "End",
      "preconditionStepId": "penalty"
    }
  ]
}
