{
  "id": "agent-guarded",
  "name": "An agent whose refunds need approval, that reports tool errors and has budgets",
  "version": 1,
  "steps": [
    { "id": "start", "type": "START", "name": "Start" },
    { "id": "agent", "type": "AGENT_CALL", "name": "Agent", "preconditionStepId": "start",
      "agent": {
        "connection": "claude",
        "goal": "Handle ${ticket}",
        "tools": [
          { "name": "openRefund", "description": "Open a refund.", "step": "open-refund",
            "approval": { "formId": "approve-refund", "candidateGroups": ["leads"] } },
          { "name": "flaky", "description": "A tool that fails.", "step": "flaky" }
        ],
        "output": { "variable": "answer" },
        "maxSteps": 3,
        "maxTokens": 1000,
        "maxDuration": "PT1H",
        "onToolError": "report"
      } },
    { "id": "end", "type": "END", "name": "End", "preconditionStepId": "agent" },
    { "id": "open-refund", "type": "ACTION", "name": "Open a refund" },
    { "id": "flaky", "type": "ACTION", "name": "Flaky" }
  ]
}
