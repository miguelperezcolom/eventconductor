{
  "id": "cron",
  "name": "Cron started process",
  "version": 1,
  "cronExpression": "* * * * * *",
  "steps": [
    {
      "id": "start",
      "type": "START",
      "name": "Start"
    },
    {
      "id": "tick",
      "type": "ACTION",
      "name": "Tick",
      "topic": "work",
      "preconditionStepId": "start"
    },
    {
      "id": "end",
      "type": "END",
      "name": "End",
      "preconditionStepId": "tick"
    }
  ]
}
