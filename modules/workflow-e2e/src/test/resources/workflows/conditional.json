{
  "id": "conditional",
  "name": "Conditional branch",
  "version": 1,
  "steps": [
    {
      "id": "start",
      "type": "START",
      "name": "Start"
    },
    {
      "id": "gate",
      "type": "ACTION",
      "name": "Gate",
      "topic": "work",
      "preconditionStepId": "start"
    },
    {
      "id": "premium",
      "type": "ACTION",
      "name": "Premium only",
      "topic": "work",
      "preconditionStepId": "gate",
      "preconditionExpression": "tier == 'premium'"
    },
    {
      "id": "end",
      "type": "END",
      "name": "End",
      "preconditionStepId": "premium"
    }
  ]
}
