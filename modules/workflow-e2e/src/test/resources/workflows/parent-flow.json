{
  "id": "parent-flow",
  "name": "Parent workflow with a child PROCESS step",
  "version": 1,
  "steps": [
    {
      "id": "start",
      "type": "START",
      "name": "Start"
    },
    {
      "id": "spawn-child",
      "type": "PROCESS",
      "name": "Spawn the child",
      "preconditionStepId": "start",
      "childWorkflowDefinitionId": "child-flow",
      "outputVariables": [
        "result"
      ]
    },
    {
      "id": "end",
      "type": "END",
      "name": "End",
      "preconditionStepId": "spawn-child"
    }
  ]
}
