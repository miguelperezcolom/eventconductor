{
  "id": "seq",
  "name": "Sequential",
  "version": 1,
  "steps": [
    {
      "id": "start",
      "type": "START",
      "name": "Start"
    },
    {
      "id": "s1",
      "type": "ACTION",
      "name": "Step 1",
      "topic": "work",
      "preconditionStepId": "start"
    },
    {
      "id": "s2",
      "type": "ACTION",
      "name": "Step 2",
      "topic": "work",
      "preconditionStepId": "s1",
      "preconditionExpression": "amount > 100"
    },
    {
      "id": "end",
      "type": "END",
      "name": "End",
      "preconditionStepId": "s2"
    }
  ]
}
