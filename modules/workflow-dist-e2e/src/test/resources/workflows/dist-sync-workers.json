{
  "id": "dist-sync-workers",
  "name": "Synchronous, two Kafka-worker steps",
  "version": 1,
  "syncInvocation": { "enabled": true },
  "steps": [
    { "id": "start", "type": "START", "name": "Start" },
    { "id": "s1", "type": "ACTION", "name": "Step 1", "topic": "work", "preconditionStepId": "start" },
    { "id": "s2", "type": "ACTION", "name": "Step 2", "topic": "work", "preconditionStepId": "s1" },
    { "id": "reply", "type": "REPLY", "name": "Reply", "replyVariables": ["orderId"], "preconditionStepId": "s2" },
    { "id": "end", "type": "END", "name": "End", "preconditionStepId": "reply" }
  ]
}
