<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      Parent for a generated TASK MODULE: a library a developer adds to any Spring Boot service and
      then only implements the generated interfaces. All the build logic lives here (decision 14),
      so the generated project is just coordinates plus a few ec.* properties. It brings the
      worker-api the generated code compiles against and runs the generator in generate-sources; the
      host service picks the transport (worker-kafka or worker-embedded).
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>io.mateu.workflow</groupId>
    <artifactId>task-module-parent</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>task-module-parent</name>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Not published to Maven Central in the engine release: this parent inherits
             spring-boot-starter-parent (to hand downstream projects Spring Boot's dependency
             management), so it does not inherit the engine's central-publishing configuration and the
             default deploy has no repository. It is built and tested in the reactor; publishing it
             (with its own central-publishing setup) comes with the first downstream consumer. -->
        <maven.deploy.skip>true</maven.deploy.skip>

        <!-- The EventConductor artifacts (runtime + plugin) this project builds against. -->
        <ec.version>1.0-SNAPSHOT</ec.version>
        <spring-cloud.version>2025.1.3</spring-cloud.version>

        <!-- Overridden by the generated project. Where the definitions come from and which tasks to
             build; the base package for the generated types. Documented in the generated README. -->
        <ec.definitions/>
        <ec.repository/>
        <ec.ref/>
        <ec.group/>
        <ec.tasks/>
        <ec.basePackage>tasks.generated</ec.basePackage>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- What the generated interfaces, records and registrations compile against. -->
        <dependency>
            <groupId>io.mateu.workflow</groupId>
            <artifactId>worker-api</artifactId>
            <version>${ec.version}</version>
        </dependency>
        <!-- The generated @AutoConfiguration and @Bean/@ConditionalOnProperty annotations. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Generate the task types into generated-sources before compilation. The generated
                 project supplies the ec.* properties; nothing else. -->
            <plugin>
                <groupId>io.mateu.workflow</groupId>
                <artifactId>workflow-maven-plugin</artifactId>
                <version>${ec.version}</version>
                <executions>
                    <execution>
                        <id>generate-worker-sources</id>
                        <goals>
                            <goal>generate-worker-sources</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <basePackage>${ec.basePackage}</basePackage>
                    <definitions>${ec.definitions}</definitions>
                    <repository>${ec.repository}</repository>
                    <ref>${ec.ref}</ref>
                    <group>${ec.group}</group>
                    <tasks>${ec.tasks}</tasks>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
