{
  "id": "shipping-costs",
  "name": "Shipping costs",
  "description": "Shipping cost and courier by customer category and order total",
  "type": "decision-table",
  "hitPolicy": "FIRST",
  "inputs": ["customer.category", "order.total"],
  "outputs": ["shippingCost", "courier"],
  "rows": [
    { "when": ["VIP", "*"],     "then": ["0",  "'express'"]  },
    { "when": ["*",   "> 100"], "then": ["5",  "'standard'"] },
    { "when": ["*",   "*"],     "then": ["10", "'standard'"] }
  ]
}
