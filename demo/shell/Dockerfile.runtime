# Runtime-only image from a locally-built jar (carries the edge-to-edge shell). Non-root + writes
# only to /tmp, to satisfy the deployment's runAsNonRoot + readOnlyRootFilesystem.
FROM eclipse-temurin:21-jre-alpine
RUN addgroup -S app && adduser -S -G app -u 10001 app
WORKDIR /opt/app
COPY --chown=app:app target/shell-*.jar app.jar
ENV SERVER_PORT=8101 JAVA_TOOL_OPTIONS=-Djava.io.tmpdir=/tmp
USER app
EXPOSE 8101
ENTRYPOINT ["java", "-jar", "app.jar"]
