# Runtime-only image from a locally-built jar (the booking saga's worker side). Non-root and writing only to /tmp, so it
# satisfies the deployment's runAsNonRoot + readOnlyRootFilesystem — the same shape as the two
# demo services that already had one.
FROM eclipse-temurin:21-jre-alpine
RUN addgroup -S app && adduser -S -G app -u 10001 app
WORKDIR /opt/app
COPY --chown=app:app target/booking-service-*.jar app.jar
ENV SERVER_PORT=8108 JAVA_TOOL_OPTIONS=-Djava.io.tmpdir=/tmp
USER app
EXPOSE 8108
ENTRYPOINT ["java", "-jar", "app.jar"]
