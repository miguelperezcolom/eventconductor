        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by(status)(rate(http_server_requests_seconds_count{job=\"orchestrator\"}[5m]))",
          "legendFormat": "{{status}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "type": "logs",
      "title": "Orchestrator logs (Loki)",
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 24,
        "h": 7
      },
      "datasource": {
        "type": "loki",
        "uid": "P8E80F9AEF21F6940"
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true
      },
      "targets": [
        {
          "expr": "{namespace=\"eventconductor\", app=\"orchestrator\"}",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "P8E80F9AEF21F6940"
          }
        }
      ]
    },
    {
      "type": "row",
      "title": "Engine — process & saga (eventconductor.*)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Processes running",
      "description": "Gauge eventconductor.process.running — instances currently RUNNING.",
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
