        {
          "expr": "hikaricp_connections_idle{job=~\"orchestrator|forms|rules\"}",
          "legendFormat": "{{job}} idle",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP requests by status (orchestrator)",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 15,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
