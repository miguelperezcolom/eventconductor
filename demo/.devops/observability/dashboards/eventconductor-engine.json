    {
      "type": "timeseries",
      "title": "Sync: callers waiting · how they were woken",
      "description": "Callers waiting per pod, and how replies reached them — a rising share of 'poll' means cross-pod NOTIFY is not working.",
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
