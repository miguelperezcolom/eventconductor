    {
      "type": "stat",
      "title": "Outbox pending",
      "description": "Gauge eventconductor.outbox.pending — messages waiting to be relayed (jpa mode). Rises during a broker outage; must return to zero.",
      "gridPos": {
        "x": 6,
        "y": 27,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(eventconductor_outbox_pending)",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "type": "stat",
      "title": "Stalled steps (ALERT)",
      "description": "Gauge eventconductor.steps.stalled — ACTION/RULE steps with no deadline waiting on a worker. The one gauge to alert on. Cluster-wide: alert on max across replicas.",
