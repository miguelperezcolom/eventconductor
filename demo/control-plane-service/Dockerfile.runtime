# Runtime-only image from a locally-built jar (carries the ControlPlaneHome restyle). Non-root +
# writes only to /tmp, to satisfy the deployment's runAsNonRoot + readOnlyRootFilesystem.
FROM eclipse-temurin:21-jre-alpine
RUN addgroup -S app && adduser -S -G app -u 10001 app
WORKDIR /opt/app
COPY --chown=app:app target/control-plane-service-*.jar app.jar
ENV SERVER_PORT=8103 JAVA_TOOL_OPTIONS=-Djava.io.tmpdir=/tmp
USER app
EXPOSE 8103
ENTRYPOINT ["java", "-jar", "app.jar"]
