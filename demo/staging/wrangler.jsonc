{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eventconductor",
  "main": "index.js", // <--- AÑADE ESTO
  "compatibility_date": "2025-09-27",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS" // Esto permite que env.ASSETS funcione
  },
  "observability": {
    "enabled": true
  }
}