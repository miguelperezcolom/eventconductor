{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eventconductor",
  "main": "index.js",
  "compatibility_date": "2025-09-27",
  "vars": {
    "DEFAULT_VERSION": "v0000000001" // Este valor se usará si no hay uno en el panel
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  }
}