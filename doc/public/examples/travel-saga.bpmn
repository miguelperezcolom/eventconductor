<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_TravelSaga" targetNamespace="http://mateu.io/bpmn/travel-saga">
  <bpmn:message id="Msg_trip_requested" name="trip.requested"/>
  <bpmn:message id="Msg_flight_book" name="flight.book"/>
  <bpmn:message id="Msg_flight_booked" name="flight.booked"/>
  <bpmn:message id="Msg_flight_rejected" name="flight.rejected"/>
  <bpmn:message id="Msg_flight_cancel" name="flight.cancel"/>
  <bpmn:message id="Msg_flight_cancelled" name="flight.cancelled"/>
  <bpmn:message id="Msg_stay_book" name="stay.book"/>
  <bpmn:message id="Msg_stay_booked" name="stay.booked"/>
  <bpmn:message id="Msg_stay_rejected" name="stay.rejected"/>
  <bpmn:message id="Msg_stay_cancel" name="stay.cancel"/>
  <bpmn:message id="Msg_stay_cancelled" name="stay.cancelled"/>
  <bpmn:message id="Msg_transfer_book" name="transfer.book"/>
  <bpmn:message id="Msg_transfer_booked" name="transfer.booked"/>
  <bpmn:message id="Msg_transfer_rejected" name="transfer.rejected"/>
  <bpmn:message id="Msg_transfer_cancel" name="transfer.cancel"/>
  <bpmn:message id="Msg_transfer_cancelled" name="transfer.cancelled"/>
  <bpmn:message id="Msg_excursions_book" name="excursions.book"/>
  <bpmn:message id="Msg_excursions_booked" name="excursions.booked"/>
  <bpmn:message id="Msg_excursions_rejected" name="excursions.rejected"/>
  <bpmn:message id="Msg_excursions_cancel" name="excursions.cancel"/>
  <bpmn:message id="Msg_excursions_cancelled" name="excursions.cancelled"/>
  <bpmn:message id="Msg_confirmation_send" name="confirmation.send"/>
  <bpmn:message id="Msg_confirmation_sent" name="confirmation.sent"/>
  <bpmn:error id="Err_Paso" name="Step exhausted" errorCode="STEP_EXHAUSTED"/>
  <bpmn:escalation id="Esc_Comp" name="Compensation failed" escalationCode="COMPENSATION_FAILED"/>
  <bpmn:process id="TravelSaga" name="Trip booking saga (BPMN)" isExecutable="true">
    <bpmn:startEvent id="Start" name="Trip requested">
      <bpmn:outgoing>In_Flight</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_Start" messageRef="Msg_trip_requested"/>
    </bpmn:startEvent>
    <bpmn:subProcess id="SP_Flight" name="Reserve flight (flight-service)">
      <bpmn:incoming>In_Flight</bpmn:incoming>
      <bpmn:outgoing>In_Stay</bpmn:outgoing>
      <bpmn:startEvent id="Start_Flight"><bpmn:outgoing>Flight1</bpmn:outgoing></bpmn:startEvent>
      <bpmn:sendTask id="Send_Flight" name="Publish flight.book" messageRef="Msg_flight_book">
        <bpmn:incoming>Flight1</bpmn:incoming><bpmn:incoming>Flight10</bpmn:incoming>
        <bpmn:outgoing>Flight2</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:eventBasedGateway id="Gwe_Flight" name="Wait for the worker">
        <bpmn:incoming>Flight2</bpmn:incoming>
        <bpmn:outgoing>Flight3</bpmn:outgoing>
        <bpmn:outgoing>Flight4</bpmn:outgoing>
        <bpmn:outgoing>Flight5</bpmn:outgoing>
      </bpmn:eventBasedGateway>
      <bpmn:intermediateCatchEvent id="C_Flight_ok" name="flight.booked">
        <bpmn:incoming>Flight3</bpmn:incoming><bpmn:outgoing>Flight6</bpmn:outgoing>
        <bpmn:messageEventDefinition id="MED_Flight_ok" messageRef="Msg_flight_booked"/>
      </bpmn:intermediateCatchEvent>
      <bpmn:endEvent id="E_Flight_ok" name="Done"><bpmn:incoming>Flight6</bpmn:incoming></bpmn:endEvent>
      <bpmn:intermediateCatchEvent id="C_Flight_to" name="2 min without a reply">
        <bpmn:incoming>Flight4</bpmn:incoming><bpmn:outgoing>Flight7</bpmn:outgoing>
        <bpmn:timerEventDefinition id="TED_Flight"><bpmn:timeDuration>PT2M</bpmn:timeDuration></bpmn:timerEventDefinition>
      </bpmn:intermediateCatchEvent>
      <bpmn:intermediateCatchEvent id="C_Flight_ko" name="flight.rejected">
        <bpmn:incoming>Flight5</bpmn:incoming><bpmn:outgoing>Flight8</bpmn:outgoing>
        <bpmn:messageEventDefinition id="MED_Flight_ko" messageRef="Msg_flight_rejected"/>
      </bpmn:intermediateCatchEvent>
      <bpmn:exclusiveGateway id="Gwr_Flight" name="Retries left?" default="Flight11">
        <bpmn:incoming>Flight7</bpmn:incoming>
        <bpmn:incoming>Flight8</bpmn:incoming>
        <bpmn:outgoing>Flight9</bpmn:outgoing><bpmn:outgoing>Flight11</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:scriptTask id="T_Flight_inc" name="attempts + 1" scriptFormat="javascript">
        <bpmn:incoming>Flight9</bpmn:incoming><bpmn:outgoing>Flight10</bpmn:outgoing>
        <bpmn:script>attempts_Flight = attempts_Flight + 1;</bpmn:script>
      </bpmn:scriptTask>
      <bpmn:endEvent id="E_Flight_fail" name="Out of retries">
        <bpmn:incoming>Flight11</bpmn:incoming>
        <bpmn:errorEventDefinition id="EED_Flight" errorRef="Err_Paso"/>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flight1" sourceRef="Start_Flight" targetRef="Send_Flight"/>
      <bpmn:sequenceFlow id="Flight2" sourceRef="Send_Flight" targetRef="Gwe_Flight"/>
      <bpmn:sequenceFlow id="Flight3" sourceRef="Gwe_Flight" targetRef="C_Flight_ok"/>
      <bpmn:sequenceFlow id="Flight4" sourceRef="Gwe_Flight" targetRef="C_Flight_to"/>
      <bpmn:sequenceFlow id="Flight6" sourceRef="C_Flight_ok" targetRef="E_Flight_ok"/>
      <bpmn:sequenceFlow id="Flight7" sourceRef="C_Flight_to" targetRef="Gwr_Flight"/>
      <bpmn:sequenceFlow id="Flight9" sourceRef="Gwr_Flight" targetRef="T_Flight_inc"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${attempts_Flight &lt; 3}</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flight10" sourceRef="T_Flight_inc" targetRef="Send_Flight"/>
      <bpmn:sequenceFlow id="Flight11" sourceRef="Gwr_Flight" targetRef="E_Flight_fail"/>
      <bpmn:sequenceFlow id="Flight5" sourceRef="Gwe_Flight" targetRef="C_Flight_ko"/>
      <bpmn:sequenceFlow id="Flight8" sourceRef="C_Flight_ko" targetRef="Gwr_Flight"/>
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="Bnd_Flight_comp" name="compensar" attachedToRef="SP_Flight" cancelActivity="false">
      <bpmn:compensateEventDefinition id="CED_Flight"/>
    </bpmn:boundaryEvent>
    <bpmn:subProcess id="SP_CancelFlight" name="Cancel flight (flight-service)" isForCompensation="true">
      <bpmn:startEvent id="Start_CancelFlight"><bpmn:outgoing>CancelFlight1</bpmn:outgoing></bpmn:startEvent>
      <bpmn:sendTask id="Send_CancelFlight" name="Publish flight.cancel" messageRef="Msg_flight_cancel">
        <bpmn:incoming>CancelFlight1</bpmn:incoming><bpmn:incoming>CancelFlight10</bpmn:incoming>
        <bpmn:outgoing>CancelFlight2</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:eventBasedGateway id="Gwe_CancelFlight" name="Wait for the worker">
        <bpmn:incoming>CancelFlight2</bpmn:incoming>
        <bpmn:outgoing>CancelFlight3</bpmn:outgoing>
        <bpmn:outgoing>CancelFlight4</bpmn:outgoing>
      </bpmn:eventBasedGateway>
      <bpmn:intermediateCatchEvent id="C_CancelFlight_ok" name="flight.cancelled">
        <bpmn:incoming>CancelFlight3</bpmn:incoming><bpmn:outgoing>CancelFlight6</bpmn:outgoing>
        <bpmn:messageEventDefinition id="MED_CancelFlight_ok" messageRef="Msg_flight_cancelled"/>
      </bpmn:intermediateCatchEvent>
      <bpmn:endEvent id="E_CancelFlight_ok" name="Done"><bpmn:incoming>CancelFlight6</bpmn:incoming></bpmn:endEvent>
      <bpmn:intermediateCatchEvent id="C_CancelFlight_to" name="2 min without a reply">
        <bpmn:incoming>CancelFlight4</bpmn:incoming><bpmn:outgoing>CancelFlight7</bpmn:outgoing>
        <bpmn:timerEventDefinition id="TED_CancelFlight"><bpmn:timeDuration>PT2M</bpmn:timeDuration></bpmn:timerEventDefinition>
      </bpmn:intermediateCatchEvent>
      <bpmn:exclusiveGateway id="Gwr_CancelFlight" name="Retries left?" default="CancelFlight11">
        <bpmn:incoming>CancelFlight7</bpmn:incoming>
        <bpmn:outgoing>CancelFlight9</bpmn:outgoing><bpmn:outgoing>CancelFlight11</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:scriptTask id="T_CancelFlight_inc" name="attempts + 1" scriptFormat="javascript">
        <bpmn:incoming>CancelFlight9</bpmn:incoming><bpmn:outgoing>CancelFlight10</bpmn:outgoing>
        <bpmn:script>attempts_CancelFlight = attempts_CancelFlight + 1;</bpmn:script>
      </bpmn:scriptTask>
      <bpmn:endEvent id="E_CancelFlight_fail" name="Compensation failed: page operations">
        <bpmn:incoming>CancelFlight11</bpmn:incoming>
        <bpmn:escalationEventDefinition id="ESD_CancelFlight" escalationRef="Esc_Comp"/>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="CancelFlight1" sourceRef="Start_CancelFlight" targetRef="Send_CancelFlight"/>
      <bpmn:sequenceFlow id="CancelFlight2" sourceRef="Send_CancelFlight" targetRef="Gwe_CancelFlight"/>
      <bpmn:sequenceFlow id="CancelFlight3" sourceRef="Gwe_CancelFlight" targetRef="C_CancelFlight_ok"/>
      <bpmn:sequenceFlow id="CancelFlight4" sourceRef="Gwe_CancelFlight" targetRef="C_CancelFlight_to"/>
      <bpmn:sequenceFlow id="CancelFlight6" sourceRef="C_CancelFlight_ok" targetRef="E_CancelFlight_ok"/>
      <bpmn:sequenceFlow id="CancelFlight7" sourceRef="C_CancelFlight_to" targetRef="Gwr_CancelFlight"/>
      <bpmn:sequenceFlow id="CancelFlight9" sourceRef="Gwr_CancelFlight" targetRef="T_CancelFlight_inc"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${attempts_CancelFlight &lt; 5}</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="CancelFlight10" sourceRef="T_CancelFlight_inc" targetRef="Send_CancelFlight"/>
      <bpmn:sequenceFlow id="CancelFlight11" sourceRef="Gwr_CancelFlight" targetRef="E_CancelFlight_fail"/>
    </bpmn:subProcess>
    <bpmn:association id="Assoc_Flight" associationDirection="One" sourceRef="Bnd_Flight_comp" targetRef="SP_CancelFlight"/>
    <bpmn:boundaryEvent id="Bnd_Flight_err" name="error" attachedToRef="SP_Flight">
      <bpmn:outgoing>Err_Flight</bpmn:outgoing>
      <bpmn:errorEventDefinition id="EBD_Flight"/>
    </bpmn:boundaryEvent>
    <bpmn:subProcess id="SP_Stay" name="Reserve stay (hotel-service)">
      <bpmn:incoming>In_Stay</bpmn:incoming>
      <bpmn:outgoing>In_Transfer</bpmn:outgoing>
      <bpmn:startEvent id="Start_Stay"><bpmn:outgoing>Stay1</bpmn:outgoing></bpmn:startEvent>
      <bpmn:sendTask id="Send_Stay" name="Publish stay.book" messageRef="Msg_stay_book">
        <bpmn:incoming>Stay1</bpmn:incoming><bpmn:incoming>Stay10</bpmn:incoming>
        <bpmn:outgoing>Stay2</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:eventBasedGateway id="Gwe_Stay" name="Wait for the worker">
        <bpmn:incoming>Stay2</bpmn:incoming>
        <bpmn:outgoing>Stay3</bpmn:outgoing>
        <bpmn:outgoing>Stay4</bpmn:outgoing>
        <bpmn:outgoing>Stay5</bpmn:outgoing>
      </bpmn:eventBasedGateway>
      <bpmn:intermediateCatchEvent id="C_Stay_ok" name="stay.booked">
        <bpmn:incoming>Stay3</bpmn:incoming><bpmn:outgoing>Stay6</bpmn:outgoing>
        <bpmn:messageEventDefinition id="MED_Stay_ok" messageRef="Msg_stay_booked"/>
      </bpmn:intermediateCatchEvent>
      <bpmn:endEvent id="E_Stay_ok" name="Done"><bpmn:incoming>Stay6</bpmn:incoming></bpmn:endEvent>
      <bpmn:intermediateCatchEvent id="C_Stay_to" name="2 min without a reply">
        <bpmn:incoming>Stay4</bpmn:incoming><bpmn:outgoing>Stay7</bpmn:outgoing>
        <bpmn:timerEventDefinition id="TED_Stay"><bpmn:timeDuration>PT2M</bpmn:timeDuration></bpmn:timerEventDefinition>
      </bpmn:intermediateCatchEvent>
      <bpmn:intermediateCatchEvent id="C_Stay_ko" name="stay.rejected">
        <bpmn:incoming>Stay5</bpmn:incoming><bpmn:outgoing>Stay8</bpmn:outgoing>
        <bpmn:messageEventDefinition id="MED_Stay_ko" messageRef="Msg_stay_rejected"/>
      </bpmn:intermediateCatchEvent>
      <bpmn:exclusiveGateway id="Gwr_Stay" name="Retries left?" default="Stay11">
        <bpmn:incoming>Stay7</bpmn:incoming>
        <bpmn:incoming>Stay8</bpmn:incoming>
        <bpmn:outgoing>Stay9</bpmn:outgoing><bpmn:outgoing>Stay11</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:scriptTask id="T_Stay_inc" name="attempts + 1" scriptFormat="javascript">
        <bpmn:incoming>Stay9</bpmn:incoming><bpmn:outgoing>Stay10</bpmn:outgoing>
        <bpmn:script>attempts_Stay = attempts_Stay + 1;</bpmn:script>
      </bpmn:scriptTask>
      <bpmn:endEvent id="E_Stay_fail" name="Out of retries">
        <bpmn:incoming>Stay11</bpmn:incoming>
        <bpmn:errorEventDefinition id="EED_Stay" errorRef="Err_Paso"/>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Stay1" sourceRef="Start_Stay" targetRef="Send_Stay"/>
      <bpmn:sequenceFlow id="Stay2" sourceRef="Send_Stay" targetRef="Gwe_Stay"/>
      <bpmn:sequenceFlow id="Stay3" sourceRef="Gwe_Stay" targetRef="C_Stay_ok"/>
      <bpmn:sequenceFlow id="Stay4" sourceRef="Gwe_Stay" targetRef="C_Stay_to"/>
      <bpmn:sequenceFlow id="Stay6" sourceRef="C_Stay_ok" targetRef="E_Stay_ok"/>
      <bpmn:sequenceFlow id="Stay7" sourceRef="C_Stay_to" targetRef="Gwr_Stay"/>
      <bpmn:sequenceFlow id="Stay9" sourceRef="Gwr_Stay" targetRef="T_Stay_inc"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${attempts_Stay &lt; 3}</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Stay10" sourceRef="T_Stay_inc" targetRef="Send_Stay"/>
      <bpmn:sequenceFlow id="Stay11" sourceRef="Gwr_Stay" targetRef="E_Stay_fail"/>
      <bpmn:sequenceFlow id="Stay5" sourceRef="Gwe_Stay" targetRef="C_Stay_ko"/>
      <bpmn:sequenceFlow id="Stay8" sourceRef="C_Stay_ko" targetRef="Gwr_Stay"/>
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="Bnd_Stay_comp" name="compensar" attachedToRef="SP_Stay" cancelActivity="false">
      <bpmn:compensateEventDefinition id="CED_Stay"/>
    </bpmn:boundaryEvent>
    <bpmn:subProcess id="SP_CancelStay" name="Cancel stay (hotel-service)" isForCompensation="true">
      <bpmn:startEvent id="Start_CancelStay"><bpmn:outgoing>CancelStay1</bpmn:outgoing></bpmn:startEvent>
      <bpmn:sendTask id="Send_CancelStay" name="Publish stay.cancel" messageRef="Msg_stay_cancel">
        <bpmn:incoming>CancelStay1</bpmn:incoming><bpmn:incoming>CancelStay10</bpmn:incoming>
        <bpmn:outgoing>CancelStay2</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:eventBasedGateway id="Gwe_CancelStay" name="Wait for the worker">
        <bpmn:incoming>CancelStay2</bpmn:incoming>
        <bpmn:outgoing>CancelStay3</bpmn:outgoing>
        <bpmn:outgoing>CancelStay4</bpmn:outgoing>
      </bpmn:eventBasedGateway>
      <bpmn:intermediateCatchEvent id="C_CancelStay_ok" name="stay.cancelled">
        <bpmn:incoming>CancelStay3</bpmn:incoming><bpmn:outgoing>CancelStay6</bpmn:outgoing>
        <bpmn:messageEventDefinition id="MED_CancelStay_ok" messageRef="Msg_stay_cancelled"/>
      </bpmn:intermediateCatchEvent>
      <bpmn:endEvent id="E_CancelStay_ok" name="Done"><bpmn:incoming>CancelStay6</bpmn:incoming></bpmn:endEvent>
      <bpmn:intermediateCatchEvent id="C_CancelStay_to" name="2 min without a reply">
        <bpmn:incoming>CancelStay4</bpmn:incoming><bpmn:outgoing>CancelStay7</bpmn:outgoing>
        <bpmn:timerEventDefinition id="TED_CancelStay"><bpmn:timeDuration>PT2M</bpmn:timeDuration></bpmn:timerEventDefinition>
      </bpmn:intermediateCatchEvent>
      <bpmn:exclusiveGateway id="Gwr_CancelStay" name="Retries left?" default="CancelStay11">
        <bpmn:incoming>CancelStay7</bpmn:incoming>
        <bpmn:outgoing>CancelStay9</bpmn:outgoing><bpmn:outgoing>CancelStay11</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:scriptTask id="T_CancelStay_inc" name="attempts + 1" scriptFormat="javascript">
        <bpmn:incoming>CancelStay9</bpmn:incoming><bpmn:outgoing>CancelStay10</bpmn:outgoing>
        <bpmn:script>attempts_CancelStay = attempts_CancelStay + 1;</bpmn:script>
      </bpmn:scriptTask>
      <bpmn:endEvent id="E_CancelStay_fail" name="Compensation failed: page operations">
        <bpmn:incoming>CancelStay11</bpmn:incoming>
        <bpmn:escalationEventDefinition id="ESD_CancelStay" escalationRef="Esc_Comp"/>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="CancelStay1" sourceRef="Start_CancelStay" targetRef="Send_CancelStay"/>
      <bpmn:sequenceFlow id="CancelStay2" sourceRef="Send_CancelStay" targetRef="Gwe_CancelStay"/>
      <bpmn:sequenceFlow id="CancelStay3" sourceRef="Gwe_CancelStay" targetRef="C_CancelStay_ok"/>
      <bpmn:sequenceFlow id="CancelStay4" sourceRef="Gwe_CancelStay" targetRef="C_CancelStay_to"/>
      <bpmn:sequenceFlow id="CancelStay6" sourceRef="C_CancelStay_ok" targetRef="E_CancelStay_ok"/>
      <bpmn:sequenceFlow id="CancelStay7" sourceRef="C_CancelStay_to" targetRef="Gwr_CancelStay"/>
      <bpmn:sequenceFlow id="CancelStay9" sourceRef="Gwr_CancelStay" targetRef="T_CancelStay_inc"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${attempts_CancelStay &lt; 5}</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="CancelStay10" sourceRef="T_CancelStay_inc" targetRef="Send_CancelStay"/>
      <bpmn:sequenceFlow id="CancelStay11" sourceRef="Gwr_CancelStay" targetRef="E_CancelStay_fail"/>
    </bpmn:subProcess>
    <bpmn:association id="Assoc_Stay" associationDirection="One" sourceRef="Bnd_Stay_comp" targetRef="SP_CancelStay"/>
    <bpmn:boundaryEvent id="Bnd_Stay_err" name="error" attachedToRef="SP_Stay">
      <bpmn:outgoing>Err_Stay</bpmn:outgoing>
      <bpmn:errorEventDefinition id="EBD_Stay"/>
    </bpmn:boundaryEvent>
    <bpmn:subProcess id="SP_Transfer" name="Reserve transfer (transfer-service)">
      <bpmn:incoming>In_Transfer</bpmn:incoming>
      <bpmn:outgoing>In_Excursions</bpmn:outgoing>
      <bpmn:startEvent id="Start_Transfer"><bpmn:outgoing>Transfer1</bpmn:outgoing></bpmn:startEvent>
      <bpmn:sendTask id="Send_Transfer" name="Publish transfer.book" messageRef="Msg_transfer_book">
        <bpmn:incoming>Transfer1</bpmn:incoming><bpmn:incoming>Transfer10</bpmn:incoming>
        <bpmn:outgoing>Transfer2</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:eventBasedGateway id="Gwe_Transfer" name="Wait for the worker">
        <bpmn:incoming>Transfer2</bpmn:incoming>
        <bpmn:outgoing>Transfer3</bpmn:outgoing>
        <bpmn:outgoing>Transfer4</bpmn:outgoing>
        <bpmn:outgoing>Transfer5</bpmn:outgoing>
      </bpmn:eventBasedGateway>
      <bpmn:intermediateCatchEvent id="C_Transfer_ok" name="transfer.booked">
        <bpmn:incoming>Transfer3</bpmn:incoming><bpmn:outgoing>Transfer6</bpmn:outgoing>
        <bpmn:messageEventDefinition id="MED_Transfer_ok" messageRef="Msg_transfer_booked"/>
      </bpmn:intermediateCatchEvent>
      <bpmn:endEvent id="E_Transfer_ok" name="Done"><bpmn:incoming>Transfer6</bpmn:incoming></bpmn:endEvent>
      <bpmn:intermediateCatchEvent id="C_Transfer_to" name="1 min without a reply">
        <bpmn:incoming>Transfer4</bpmn:incoming><bpmn:outgoing>Transfer7</bpmn:outgoing>
        <bpmn:timerEventDefinition id="TED_Transfer"><bpmn:timeDuration>PT1M</bpmn:timeDuration></bpmn:timerEventDefinition>
      </bpmn:intermediateCatchEvent>
      <bpmn:intermediateCatchEvent id="C_Transfer_ko" name="transfer.rejected">
        <bpmn:incoming>Transfer5</bpmn:incoming><bpmn:outgoing>Transfer8</bpmn:outgoing>
        <bpmn:messageEventDefinition id="MED_Transfer_ko" messageRef="Msg_transfer_rejected"/>
      </bpmn:intermediateCatchEvent>
      <bpmn:exclusiveGateway id="Gwr_Transfer" name="Retries left?" default="Transfer11">
        <bpmn:incoming>Transfer7</bpmn:incoming>
        <bpmn:incoming>Transfer8</bpmn:incoming>
        <bpmn:outgoing>Transfer9</bpmn:outgoing><bpmn:outgoing>Transfer11</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:scriptTask id="T_Transfer_inc" name="attempts + 1" scriptFormat="javascript">
        <bpmn:incoming>Transfer9</bpmn:incoming><bpmn:outgoing>Transfer10</bpmn:outgoing>
        <bpmn:script>attempts_Transfer = attempts_Transfer + 1;</bpmn:script>
      </bpmn:scriptTask>
      <bpmn:endEvent id="E_Transfer_fail" name="Out of retries">
        <bpmn:incoming>Transfer11</bpmn:incoming>
        <bpmn:errorEventDefinition id="EED_Transfer" errorRef="Err_Paso"/>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Transfer1" sourceRef="Start_Transfer" targetRef="Send_Transfer"/>
      <bpmn:sequenceFlow id="Transfer2" sourceRef="Send_Transfer" targetRef="Gwe_Transfer"/>
      <bpmn:sequenceFlow id="Transfer3" sourceRef="Gwe_Transfer" targetRef="C_Transfer_ok"/>
      <bpmn:sequenceFlow id="Transfer4" sourceRef="Gwe_Transfer" targetRef="C_Transfer_to"/>
      <bpmn:sequenceFlow id="Transfer6" sourceRef="C_Transfer_ok" targetRef="E_Transfer_ok"/>
      <bpmn:sequenceFlow id="Transfer7" sourceRef="C_Transfer_to" targetRef="Gwr_Transfer"/>
      <bpmn:sequenceFlow id="Transfer9" sourceRef="Gwr_Transfer" targetRef="T_Transfer_inc"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${attempts_Transfer &lt; 3}</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Transfer10" sourceRef="T_Transfer_inc" targetRef="Send_Transfer"/>
