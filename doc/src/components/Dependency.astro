---
import { Code } from 'astro:components';

const { artifactId = 'workflow-engine' } = Astro.props;
const groupId = 'io.mateu.workflow';
const repoPath = groupId.replace(/\./g, '/');

let version = 'LATEST';
try {
  const res = await fetch(
    `https://repo1.maven.org/maven2/${repoPath}/${artifactId}/maven-metadata.xml`
  );
  const xml = await res.text();
  version = xml.match(/<release>(.*?)<\/release>/)?.[1] ?? version;
} catch {
  // use fallback
}

const code = `<dependency>
    <groupId>${groupId}</groupId>
    <artifactId>${artifactId}</artifactId>
    <version>${version}</version>
</dependency>`;
---

<Code code={code} lang="xml" />
