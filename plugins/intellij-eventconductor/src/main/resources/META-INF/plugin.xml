<idea-plugin>
    <id>io.mateu.eventconductor</id>
    <name>EventConductor</name>
    <vendor url="https://github.com/miguelperezcolom/eventconductor">EventConductor</vendor>

    <description><![CDATA[
        Edit EventConductor workflow definitions (<code>.ec</code>) as an interactive graph and form
        definitions (<code>.ecform</code>) as a visual editor, or as YAML/JSON with schema validation.
        The graph and form editors are the same components used inside the EventConductor app,
        embedded via JCEF, backed by the text document so both views stay in sync.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.json</depends>
    <depends>org.jetbrains.plugins.yaml</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Parse .ec and .ecform as YAML (a JSON superset) so they get highlighting and, together
             with the schema providers below, validation. Without a file-type association they are
             plain text and the JSON-schema engine has no PSI to validate. Multiple extensions are
             semicolon-separated. (.ecform, not .form: .form is reserved by IntelliJ's built-in
             Swing GUI Designer, which would suppress our editor.) -->
        <fileType name="YAML" extensions="ec;ecform;ecrule;ectask"/>
        <!-- Split editors: text (YAML/JSON) on one side, the interactive JCEF view on the other.
             .ec gets the workflow graph; .ecform gets the visual form editor. Each provider's accept()
             is scoped to its own extension. -->
        <fileEditorProvider implementation="com.eventconductor.intellij.EcFileEditorProvider"/>
        <fileEditorProvider implementation="com.eventconductor.intellij.FormFileEditorProvider"/>
    </extensions>

    <!-- Validate/complete .ec and .ecform against their JSON schemas (applies to YAML too).
         The JSON-schema provider EP lives in the JavaScript namespace. -->
    <extensions defaultExtensionNs="JavaScript">
        <JsonSchema.ProviderFactory implementation="com.eventconductor.intellij.EcJsonSchemaProviderFactory"/>
        <JsonSchema.ProviderFactory implementation="com.eventconductor.intellij.FormJsonSchemaProviderFactory"/>
        <JsonSchema.ProviderFactory implementation="com.eventconductor.intellij.RuleJsonSchemaProviderFactory"/>
        <JsonSchema.ProviderFactory implementation="com.eventconductor.intellij.TaskJsonSchemaProviderFactory"/>
    </extensions>

    <!-- Scaffold a worker project from a task contract, or wire an existing module to one. The
         create actions reuse worker-codegen (the same templates the Maven goal and the UI use), so a
         developer goes from a .ectask to a buildable module or service without leaving the editor. -->
    <actions>
        <group id="eventconductor.taskActions" text="EventConductor" popup="true">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <action id="eventconductor.createTaskModule"
                    class="com.eventconductor.intellij.CreateTaskModuleAction"
                    text="Create Task Module"
                    description="Generate a task-module project (a library added to a Spring Boot service) from this task contract."/>
            <action id="eventconductor.createTaskService"
                    class="com.eventconductor.intellij.CreateTaskServiceAction"
                    text="Create Task Service"
                    description="Generate a standalone Kafka task-service project from this task contract."/>
            <action id="eventconductor.addTaskDependency"
                    class="com.eventconductor.intellij.AddTaskDependencyAction"
                    text="Add Task Dependency"
                    description="Add a dependency on this task's generated &lt;group&gt;-tasks module to the nearest pom.xml."/>
        </group>
    </actions>
</idea-plugin>
