<idea-plugin>
    <id>io.mateu.eventconductor</id>
    <name>EventConductor</name>
    <vendor url="https://github.com/miguelperezcolom/eventconductor">EventConductor</vendor>

    <description><![CDATA[
        Edit EventConductor workflow definitions (<code>.ec</code> files) as an interactive graph
        or as YAML/JSON with schema validation. The graph is the same component used inside the
        EventConductor app, embedded via JCEF, backed by the text document so both views stay in sync.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.json</depends>
    <depends>org.jetbrains.plugins.yaml</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Parse .ec as YAML (a JSON superset) so it gets highlighting and, together with the
             schema provider below, validation. Without a file-type association it is plain text
             and the JSON-schema engine has no PSI to validate. -->
        <fileType name="YAML" extensions="ec"/>
        <!-- A split editor: text (YAML/JSON) on one side, the interactive graph (JCEF) on the other. -->
        <fileEditorProvider implementation="com.eventconductor.intellij.EcFileEditorProvider"/>
    </extensions>

    <!-- Validate/complete .ec against the workflow-definition JSON schema (applies to YAML too).
         The JSON-schema provider EP lives in the JavaScript namespace. -->
    <extensions defaultExtensionNs="JavaScript">
        <JsonSchema.ProviderFactory implementation="com.eventconductor.intellij.EcJsonSchemaProviderFactory"/>
    </extensions>
</idea-plugin>
