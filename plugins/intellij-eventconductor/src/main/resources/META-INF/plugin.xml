<idea-plugin>
    <id>io.mateu.eventconductor</id>
    <name>EventConductor</name>
    <vendor url="https://github.com/miguelperezcolom/eventconductor">EventConductor</vendor>

    <description><![CDATA[
        Edit EventConductor workflow definitions (<code>.ec</code>) as an interactive graph and form
        definitions (<code>.form</code>) as a visual editor, or as YAML/JSON with schema validation.
        The graph and form editors are the same components used inside the EventConductor app,
        embedded via JCEF, backed by the text document so both views stay in sync.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.json</depends>
    <depends>org.jetbrains.plugins.yaml</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Parse .ec and .form as YAML (a JSON superset) so they get highlighting and, together
             with the schema providers below, validation. Without a file-type association they are
             plain text and the JSON-schema engine has no PSI to validate. Multiple extensions are
             semicolon-separated. -->
        <fileType name="YAML" extensions="ec;form"/>
        <!-- Split editors: text (YAML/JSON) on one side, the interactive JCEF view on the other.
             .ec gets the workflow graph; .form gets the visual form editor. Each provider's accept()
             is scoped to its own extension. -->
        <fileEditorProvider implementation="com.eventconductor.intellij.EcFileEditorProvider"/>
        <fileEditorProvider implementation="com.eventconductor.intellij.FormFileEditorProvider"/>
    </extensions>

    <!-- Validate/complete .ec and .form against their JSON schemas (applies to YAML too).
         The JSON-schema provider EP lives in the JavaScript namespace. -->
    <extensions defaultExtensionNs="JavaScript">
        <JsonSchema.ProviderFactory implementation="com.eventconductor.intellij.EcJsonSchemaProviderFactory"/>
        <JsonSchema.ProviderFactory implementation="com.eventconductor.intellij.FormJsonSchemaProviderFactory"/>
    </extensions>
</idea-plugin>
