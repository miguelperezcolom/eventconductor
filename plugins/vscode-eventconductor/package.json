{
  "name": "eventconductor-vscode",
  "displayName": "EventConductor",
  "description": "Edit workflows and forms visually; execute workflow drafts on a test engine and follow processes, child workflows, variables and logs.",
  "version": "0.2.3",
  "publisher": "miguelperezcolom",
  "license": "MIT",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.84.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/miguelperezcolom/eventconductor.git",
    "directory": "plugins/vscode-eventconductor"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onCustomEditor:eventconductor.graphEditor",
    "onCustomEditor:eventconductor.formEditor"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Visual editors remain available. Engine connections and workflow execution require a trusted workspace.",
      "restrictedConfigurations": [
        "eventconductor.testEngineUrl",
        "eventconductor.agentCatalogueUrl"
      ]
    }
  },
  "extensionPack": [
    "redhat.vscode-yaml"
  ],
  "contributes": {
    "languages": [
      {
        "id": "yaml",
        "extensions": [
          ".ec",
          ".ecform",
          ".ecrule",
          ".ectask"
        ]
      }
    ],
    "customEditors": [
      {
        "viewType": "eventconductor.graphEditor",
        "displayName": "EventConductor Graph",
        "selector": [
          {
            "filenamePattern": "*.ec"
          },
          {
            "filenamePattern": "*.workflow.yaml"
          },
          {
            "filenamePattern": "*.workflow.yml"
          },
          {
            "filenamePattern": "*.ec.yaml"
          },
          {
            "filenamePattern": "*.ec.yml"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "eventconductor.formEditor",
        "displayName": "EventConductor Form",
        "selector": [
          {
            "filenamePattern": "*.ecform"
          }
        ],
        "priority": "default"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": "*.ec",
        "url": "./schema/ec.schema.json"
      },
      {
        "fileMatch": "*.ecrule",
        "url": "./schema/rule.schema.json"
      },
      {
        "fileMatch": "*.ectask",
        "url": "./schema/task.schema.json"
      }
    ],
    "yamlValidation": [
      {
        "fileMatch": [
          "*.ec",
          "*.workflow.yaml",
          "*.workflow.yml",
          "*.ec.yaml",
          "*.ec.yml"
        ],
        "url": "./schema/ec.schema.json"
      },
      {
        "fileMatch": "*.ecform",
        "url": "./schema/form-schema.json"
      },
      {
        "fileMatch": "*.ecrule",
        "url": "./schema/rule.schema.json"
      },
      {
        "fileMatch": "*.ectask",
        "url": "./schema/task.schema.json"
      },
      {
        "fileMatch": [
          "cron.yaml",
          "cron.yml"
        ],
        "url": "./schema/cron.schema.json"
      },
      {
        "fileMatch": [
          "events.yaml",
          "events.yml"
        ],
        "url": "./schema/events.schema.json"
      }
    ],
    "commands": [
      {
        "command": "eventconductor.openAsText",
        "title": "EventConductor: Open as Text (YAML/JSON)"
      },
      {
        "command": "eventconductor.openAsGraph",
        "title": "EventConductor: Open as Graph"
      },
      {
        "command": "eventconductor.showTextBeside",
        "title": "EventConductor: Show YAML/JSON side-by-side",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "eventconductor.exportSvg",
        "title": "EventConductor: Export Graph as SVG",
        "icon": "$(export)"
      },
      {
        "command": "eventconductor.form.openAsText",
        "title": "EventConductor: Open Form as Text (YAML/JSON)"
      },
      {
        "command": "eventconductor.form.openAsForm",
        "title": "EventConductor: Open as Form"
      },
      {
        "command": "eventconductor.form.showTextBeside",
        "title": "EventConductor: Show YAML/JSON side-by-side",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "eventconductor.createTaskModule",
        "title": "EventConductor: Create Task Module"
      },
      {
        "command": "eventconductor.createTaskService",
        "title": "EventConductor: Create Task Service"
      },
      {
        "command": "eventconductor.addTaskDependency",
        "title": "EventConductor: Add Task Dependency"
      },
      {
        "command": "eventconductor.configureAgentCatalogue",
        "title": "EventConductor: Configure Agent Catalogue"
      },
      {
        "command": "eventconductor.configureTestEngine",
        "title": "EventConductor: Configure Test Engine"
      },
      {
        "command": "eventconductor.runWorkflow",
        "title": "EventConductor: Run Workflow",
        "icon": "$(play)"
      },
      {
        "command": "eventconductor.openExecution",
        "title": "EventConductor: Open Execution",
        "icon": "$(graph)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "eventconductor.exportSvg",
          "when": "activeCustomEditorId == eventconductor.graphEditor"
        }
      ],
      "explorer/context": [
        {
          "command": "eventconductor.createTaskModule",
          "when": "resourceExtname == .ectask",
          "group": "eventconductor@1"
        },
        {
          "command": "eventconductor.createTaskService",
          "when": "resourceExtname == .ectask",
          "group": "eventconductor@2"
        },
        {
          "command": "eventconductor.addTaskDependency",
          "when": "resourceExtname == .ectask",
          "group": "eventconductor@3"
        },
        {
          "command": "eventconductor.runWorkflow",
          "when": "resourceExtname == .ec && isWorkspaceTrusted",
          "group": "eventconductor@1"
        }
      ],
      "editor/context": [
        {
          "command": "eventconductor.createTaskModule",
          "when": "resourceExtname == .ectask",
          "group": "eventconductor@1"
        },
        {
          "command": "eventconductor.createTaskService",
          "when": "resourceExtname == .ectask",
          "group": "eventconductor@2"
        },
        {
          "command": "eventconductor.addTaskDependency",
          "when": "resourceExtname == .ectask",
          "group": "eventconductor@3"
        }
      ],
      "editor/title": [
        {
          "command": "eventconductor.showTextBeside",
          "when": "activeCustomEditorId == eventconductor.graphEditor",
          "group": "navigation@1"
        },
        {
          "command": "eventconductor.openAsText",
          "when": "activeCustomEditorId == eventconductor.graphEditor",
          "group": "navigation@2"
        },
        {
          "command": "eventconductor.exportSvg",
          "when": "activeCustomEditorId == eventconductor.graphEditor",
          "group": "navigation@3"
        },
        {
          "command": "eventconductor.form.showTextBeside",
          "when": "activeCustomEditorId == eventconductor.formEditor",
          "group": "navigation@1"
        },
        {
          "command": "eventconductor.form.openAsText",
          "when": "activeCustomEditorId == eventconductor.formEditor",
          "group": "navigation@2"
        },
        {
          "command": "eventconductor.runWorkflow",
          "when": "activeCustomEditorId == eventconductor.graphEditor && isWorkspaceTrusted",
          "group": "navigation@4"
        }
      ]
    },
    "configuration": {
      "title": "EventConductor",
      "properties": {
        "eventconductor.agentCatalogueUrl": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Full agent catalogue endpoint URL, for example http://127.0.0.1:18105/api/workflow-agents. Set credentials with EventConductor: Configure Agent Catalogue; never put credentials in this URL."
        },
        "eventconductor.testEngineUrl": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Test engine base URL. Configure authentication with EventConductor: Configure Test Engine; credentials are stored in SecretStorage."
        }
      }
    }
  },
  "scripts": {
    "sync-assets": "node scripts/sync-assets.js",
    "compile": "npm run sync-assets && tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "test": "npm run compile && node --test test/*.test.cjs"
  },
  "dependencies": {
    "js-yaml": "^4.3.2"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.84.0",
    "typescript": "^5.4.0"
  }
}
